# Copy this file to .env and fill in real values when they exist.
# Read by src/config/apiConfig.js. See README.md and docs/AUTH_FLOW.md.

# 'real'  -> talk to the backend at VITE_API_BASE_URL (default).
# 'mock'  -> use in-memory mock data only, no network calls. Useful for
#            frontend-only demos when the backend/database aren't running.
# Never mixed silently — src/services/api.js picks one implementation
# wholesale based on this value.
VITE_API_MODE=real

# Base URL of the backend REST API (see backend/.env.example for the
# matching API_BASE_URL / CORS_ALLOWED_ORIGIN on the backend side).
VITE_API_BASE_URL=http://localhost:3001

# The frontend never needs a GitHub client id or secret — sign-in is just a
# redirect to the backend's /auth/github/login, which builds the GitHub
# authorization URL server-side. Do not add GITHUB_CLIENT_SECRET or any
# GitHub token here; see backend/.env.example instead.
