# Copy to backend/prototypes/memory-retrieval/.env before running the similarity prototype.
# `npm run prototype:similarity` loads this file automatically
# (via `node --env-file-if-exists`).

# AWS region where you requested Bedrock model access.
AWS_REGION=us-east-1

# Bedrock embedding model to use. Defaults to amazon.titan-embed-text-v2:0
# if unset — see backend/README.md for why this model was chosen.
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0

# Option A (simplest): a long-term Bedrock API key, generated from the
# Bedrock console ("Amazon Bedrock console" -> API keys -> Generate).
# If set, the SDK authenticates with this instead of IAM credentials —
# no `aws configure` needed.
AWS_BEARER_TOKEN_BEDROCK=

# Option B: standard IAM credentials instead of a Bedrock API key. Leave
# these unset if you're using AWS_BEARER_TOKEN_BEDROCK above; only needed
# if you want SigV4 auth via `aws configure`/AWS_PROFILE instead (in which
# case don't set them here — configure the profile itself, see README).
