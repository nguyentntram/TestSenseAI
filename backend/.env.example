# Copy this file to backend/.env and fill in real values.
# Every value below is a placeholder — no real secret has ever been in this
# file. See docs/AUTH_FLOW.md and docs/DATABASE.md for how each is used.

NODE_ENV=development

# Frontend origin (Vite dev server) and this API's own base URL.
APP_BASE_URL=http://localhost:5173
API_BASE_URL=http://localhost:3001
CORS_ALLOWED_ORIGIN=http://localhost:5173

# --- GitHub OAuth App ---
# Create at https://github.com/settings/developers -> "New OAuth App".
# Homepage URL: http://localhost:5173
# Authorization callback URL: http://localhost:3001/auth/github/callback
# PENDING: scopes are centralized in backend/src/config/github.js and are
# pending confirmation from Han (PR ingestion scope research) — see
# docs/PENDING_INTEGRATIONS.md before widening them.
GITHUB_CLIENT_ID=your_github_oauth_app_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_app_client_secret
GITHUB_CALLBACK_URL=http://localhost:3001/auth/github/callback

# --- Signing secrets ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OAUTH_STATE_SECRET=replace_with_a_long_random_value
SESSION_SECRET=replace_with_a_different_long_random_value
SESSION_COOKIE_NAME=testsense_session
SESSION_TTL_SECONDS=604800
# Set to true once serving the frontend and this API over HTTPS.
COOKIE_SECURE=false

# --- Secrets storage ---
# 'local' (in-memory, dev-only, non-persistent) or 'aws' (Secrets Manager).
SECRETS_PROVIDER=local
AWS_REGION=us-east-1
SECRETS_NAME_PREFIX=testsense-ai/dev

# --- Database (CockroachDB, PostgreSQL wire-compatible) ---
# Example CockroachDB Serverless connection string shape:
# postgresql://<user>:<password>@<cluster-host>:26257/<database>?sslmode=verify-full
DATABASE_URL=postgresql://user:password@localhost:26257/testsense_ai?sslmode=disable
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# --- Amazon Bedrock ---
# Model IDs — defaults are set in backend/shared/bedrock-config.js.
# Override here only if you need a different model version per environment.
# BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
# BEDROCK_GENERATION_MODEL_ID=us.anthropic.claude-sonnet-4-6-20251101-v1:0
# BEDROCK_MAX_TOKENS=4096
#
# Retry tuning (optional — defaults: 3 attempts, 500ms base, 10s max)
# BEDROCK_MAX_RETRY_ATTEMPTS=3
# BEDROCK_RETRY_BASE_DELAY_MS=500
# BEDROCK_RETRY_MAX_DELAY_MS=10000
